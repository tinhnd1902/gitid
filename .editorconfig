root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.md]
# trailing double spaces can be a deliberate line break in Markdown
trim_trailing_whitespace = false

[*.tape]
indent_style = space
indent_size = 2

[**/testdata/**]
# fixtures are byte-exact
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
